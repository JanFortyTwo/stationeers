# Control for multiple centrifuges
# if more centrifuges are necessary, push them
# onto the stack

define Centr           690945935
define Stacker        -2020231820
define Dial            554524804
define DaylightSensor  1076425094
define DeepMiner       265720906

yield
#lbn r0 DaylightSensor HASH("Mining Daylight Sensor") Vertical 0
#sgt r0 r0 87 for day only
#sgt r0 r0 70 # all day
#sb DeepMiner On r0

define CentrCentrifuges 690945935
push HASH("Centrifuge 1")
push HASH("Centrifuge 2")
push HASH("Centrifuge 3")
push HASH("Centrifuge 4")
push HASH("Centrifuge 5")
push HASH("Centrifuge 6")
push 0

reset:
move sp 0

loop_start:
yield
add sp sp 1
lbn r0 Centr r1 Reagents 3
s db Setting r0
bgtal r0 399 Empty1
bltal r0 3 Close1
peek r1
beqz r1 reset
j loop_start

Empty1:
sbn Centr r1 On 0
sbn Centr r1 Open 0
j ra

Close1:
sbn Centr r1 Open 0
sbn Centr r1 On 1
peek r1
beqz r1 reset
sleep 2
j loop_start